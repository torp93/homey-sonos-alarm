{
  "id": "com.thomastorp.sonos-alarm",
  "version": "1.3.1",
  "compatibility": ">=12.2.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Sonos Alarms",
    "no": "Sonos-alarmer"
  },
  "description": {
    "en": "Every Sonos speaker becomes an alarm clock you can automate.",
    "no": "Hver Sonos-høyttaler blir en vekkerklokke du kan automatisere."
  },
  "category": [
    "music"
  ],
  "tags": {
    "en": [
      "sonos",
      "alarm",
      "alarm clock",
      "wake up",
      "speaker",
      "upnp",
      "local"
    ],
    "no": [
      "sonos",
      "alarm",
      "vekkerklokke",
      "vekking",
      "høyttaler",
      "upnp",
      "lokal"
    ]
  },
  "brandColor": "#D8A158",
  "author": {
    "name": "Thomas Torp"
  },
  "contributors": {
    "developers": [
      {
        "name": "Thomas Torp"
      }
    ],
    "translators": [
      {
        "name": "Thomas Torp"
      }
    ]
  },
  "contributing": {
    "donate": {
      "paypal": {
        "username": "torpthomas"
      },
      "githubSponsors": {
        "username": "torp93"
      }
    }
  },
  "homepage": "https://github.com/torp93/homey-sonos-alarm",
  "support": "https://github.com/torp93/homey-sonos-alarm/issues",
  "source": "https://github.com/torp93/homey-sonos-alarm",
  "bugs": {
    "url": "https://github.com/torp93/homey-sonos-alarm/issues"
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "api": {
    "testSpeaker": {
      "method": "POST",
      "path": "/testSpeaker"
    },
    "discover": {
      "method": "GET",
      "path": "/discover"
    },
    "overview": {
      "method": "GET",
      "path": "/overview"
    },
    "listSources": {
      "method": "GET",
      "path": "/listSources"
    },
    "setEnabled": {
      "method": "POST",
      "path": "/setEnabled"
    },
    "updateAlarm": {
      "method": "POST",
      "path": "/updateAlarm"
    },
    "createAlarm": {
      "method": "POST",
      "path": "/createAlarm"
    },
    "deleteAlarm": {
      "method": "POST",
      "path": "/deleteAlarm"
    }
  },
  "capabilities": {
    "sonos_alarm_time": {
      "type": "string",
      "title": {
        "en": "Time",
        "no": "Tidspunkt"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capability-icons/time.svg"
    },
    "sonos_alarm_recurrence": {
      "type": "string",
      "title": {
        "en": "Repeats",
        "no": "Gjentas"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capability-icons/recurrence.svg"
    },
    "sonos_alarm_room": {
      "type": "string",
      "title": {
        "en": "Room",
        "no": "Rom"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capability-icons/room.svg"
    },
    "sonos_room_next": {
      "type": "string",
      "title": {
        "en": "Next alarm",
        "no": "Neste alarm"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capability-icons/time.svg"
    },
    "sonos_room_summary": {
      "type": "string",
      "title": {
        "en": "Alarms",
        "no": "Alarmer"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capability-icons/recurrence.svg"
    },
    "sonos_room_count": {
      "type": "number",
      "title": {
        "en": "Number of alarms",
        "no": "Antall alarmer"
      },
      "getable": true,
      "setable": false,
      "decimals": 0,
      "uiComponent": "sensor",
      "icon": "/assets/capability-icons/room.svg"
    },
    "sonos_alarm_volume": {
      "type": "number",
      "title": {
        "en": "Alarm volume",
        "no": "Alarmvolum"
      },
      "getable": true,
      "setable": true,
      "min": 0,
      "max": 100,
      "step": 1,
      "units": {
        "en": "%",
        "no": "%"
      },
      "uiComponent": "slider",
      "icon": "/assets/capability-icons/volume.svg"
    }
  },
  "flow": {
    "actions": [
      {
        "id": "sonos_alarm_set_time",
        "title": {
          "en": "Set the alarm time",
          "no": "Sett alarmtidspunktet"
        },
        "titleFormatted": {
          "en": "Set the alarm to [[time]]",
          "no": "Sett alarmen til [[time]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=alarm"
          },
          {
            "name": "time",
            "type": "time",
            "title": {
              "en": "Time",
              "no": "Tidspunkt"
            }
          }
        ]
      },
      {
        "id": "sonos_alarm_set_volume",
        "title": {
          "en": "Set the alarm volume",
          "no": "Sett alarmvolumet"
        },
        "titleFormatted": {
          "en": "Set the alarm volume to [[volume]]",
          "no": "Sett alarmvolumet til [[volume]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=alarm"
          },
          {
            "name": "volume",
            "type": "number",
            "title": {
              "en": "Volume",
              "no": "Volum"
            },
            "min": 0,
            "max": 100,
            "step": 1,
            "value": 30
          }
        ]
      },
      {
        "id": "sonos_alarm_set_recurrence",
        "title": {
          "en": "Set how the alarm repeats",
          "no": "Sett hvordan alarmen gjentas"
        },
        "titleFormatted": {
          "en": "Repeat the alarm [[recurrence]]",
          "no": "Gjenta alarmen [[recurrence]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=alarm"
          },
          {
            "name": "recurrence",
            "type": "dropdown",
            "title": {
              "en": "Repeats",
              "no": "Gjentas"
            },
            "values": [
              {
                "id": "ONCE",
                "title": {
                  "en": "once",
                  "no": "én gang"
                }
              },
              {
                "id": "DAILY",
                "title": {
                  "en": "daily",
                  "no": "daglig"
                }
              },
              {
                "id": "WEEKDAYS",
                "title": {
                  "en": "on weekdays",
                  "no": "på ukedager"
                }
              },
              {
                "id": "WEEKENDS",
                "title": {
                  "en": "on weekends",
                  "no": "i helgen"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "sonos_alarm_set_days",
        "title": {
          "en": "Set the alarm days",
          "no": "Sett alarmdagene"
        },
        "titleFormatted": {
          "en": "Repeat the alarm — Mon [[monday]], Tue [[tuesday]], Wed [[wednesday]], Thu [[thursday]], Fri [[friday]], Sat [[saturday]], Sun [[sunday]]",
          "no": "Gjenta alarmen — man [[monday]], tir [[tuesday]], ons [[wednesday]], tor [[thursday]], fre [[friday]], lør [[saturday]], søn [[sunday]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=alarm"
          },
          {
            "name": "monday",
            "type": "dropdown",
            "title": {
              "en": "Monday",
              "no": "Mandag"
            },
