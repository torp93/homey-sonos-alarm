                "title": {
                  "en": "yes",
                  "no": "ja"
                }
              },
              {
                "id": "no",
                "title": {
                  "en": "no",
                  "no": "nei"
                }
              }
            ]
          },
          {
            "name": "friday",
            "type": "dropdown",
            "title": {
              "en": "Friday",
              "no": "Fredag"
            },
            "values": [
              {
                "id": "yes",
                "title": {
                  "en": "yes",
                  "no": "ja"
                }
              },
              {
                "id": "no",
                "title": {
                  "en": "no",
                  "no": "nei"
                }
              }
            ]
          },
          {
            "name": "saturday",
            "type": "dropdown",
