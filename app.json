            "name": "volume",
            "type": "number",
            "title": {
              "en": "Volume",
              "no": "Volum"
            },
            "min": 0,
            "max": 100,
            "step": 1,
            "value": 30
          },
          {
            "name": "source",
            "type": "autocomplete",
            "title": {
              "en": "Sound",
              "no": "Lyd"
            }
          }
        ]
      },
      {
        "id": "sonos_alarm_enable_all",
        "title": {
          "en": "Turn on all alarms in every room",
          "no": "Slå på alle alarmer i alle rom"
        },
        "hint": {
          "en": "Enables every Sonos alarm in the household, including alarms that have not been added to Homey.",
          "no": "Aktiverer alle Sonos-alarmer i husholdningen, også alarmer som ikke er lagt til i Homey."
        },
        "args": []
      },
      {
        "id": "sonos_alarm_enable_room",
        "title": {
          "en": "Turn on all alarms in this room",
          "no": "Slå på alle alarmer i dette rommet"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=room"
          }
        ]
      },
      {
        "id": "sonos_alarm_disable_room",
        "title": {
          "en": "Turn off all alarms in this room",
          "no": "Slå av alle alarmer i dette rommet"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=room"
          }
        ]
      },
      {
        "id": "sonos_alarm_delete_room",
        "title": {
          "en": "Delete all alarms in this room",
          "no": "Slett alle alarmer i dette rommet"
        },
        "hint": {
          "en": "Permanently deletes the alarms. Sonos has no undo, and the alarms also disappear from the Sonos app. Homey devices for them become unavailable.",
          "no": "Sletter alarmene for godt. Sonos har ingen angremulighet, og alarmene forsvinner også fra Sonos-appen. Homey-enheter for dem blir utilgjengelige."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=room"
          }
        ]
      },
      {
        "id": "sonos_alarm_delete_all",
        "title": {
          "en": "Delete all alarms in every room",
          "no": "Slett alle alarmer i alle rom"
        },
        "hint": {
          "en": "Permanently deletes every alarm in the household. Sonos has no undo. Be careful what triggers this.",
          "no": "Sletter alle alarmer i husholdningen for godt. Sonos har ingen angremulighet. Vær forsiktig med hva som trigger dette."
        },
        "args": []
      },
      {
        "id": "sonos_alarm_disable_all",
        "title": {
          "en": "Turn off all alarms in every room",
          "no": "Slå av alle alarmer i alle rom"
        },
        "hint": {
          "en": "Disables every Sonos alarm in the household, including alarms that have not been added to Homey.",
          "no": "Deaktiverer alle Sonos-alarmer i husholdningen, også alarmer som ikke er lagt til i Homey."
        },
        "args": []
      }
    ],
    "conditions": [
      {
        "id": "sonos_alarm_is_enabled",
        "title": {
          "en": "The alarm !{{is|is not}} enabled",
          "no": "Alarmen !{{er|er ikke}} aktivert"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=alarm"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "id": "room",
      "name": {
        "en": "Sonos Room",
        "no": "Sonos-rom"
      },
      "class": "other",
      "capabilities": [
        "onoff",
        "sonos_room_next",
        "sonos_room_summary",
        "sonos_room_count"
      ],
      "capabilitiesOptions": {
        "onoff": {
          "title": {
            "en": "Alarms in this room",
            "no": "Alarmer i dette rommet"
          }
        }
      },
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "New alarm",
            "no": "Ny alarm"
          },
          "children": [
            {
              "id": "newTime",
              "type": "text",
              "label": {
                "en": "Time",
                "no": "Tidspunkt"
              },
              "hint": {
                "en": "24-hour clock. 0700, 700, 7, 07.30 and 07:30 all work.",
                "no": "24-timers klokke. 0700, 700, 7, 07.30 og 07:30 fungerer alle."
              },
              "value": "07:00"
            },
            {
              "id": "availableSources",
              "type": "label",
              "label": {
                "en": "Your sounds",
                "no": "Dine lyder"
              },
              "hint": {
                "en": "Filled in from your own Sonos favourites and playlists. Copy a name into the field below.",
                "no": "Fylles inn fra dine egne Sonos-favoritter og spillelister. Kopier et navn inn i feltet under."
              },
              "value": ""
            },
            {
              "id": "newSource",
              "type": "text",
              "label": {
                "en": "Sound",
                "no": "Lyd"
              },
              "hint": {
                "en": "The built-in chime, or the name of one of your Sonos favourites or playlists as listed above. A name that does not match is reported with the full list.",
                "no": "Den innebygde tonen, eller navnet på en av dine Sonos-favoritter eller spillelister slik de står listet over. Et navn som ikke treffer rapporteres med hele lista."
              },
              "value": "Sonos chime"
            },
            {
              "id": "applyOnSave",
              "type": "checkbox",
              "label": {
                "en": "Apply when saving",
                "no": "Bruk når du lagrer"
              },
              "hint": {
                "en": "On by default. Saving adds the alarm to this room, or updates it if an alarm with the same time, days and sound is already there — so changing the volume edits that alarm instead of adding another. Turn this off to edit the values without touching Sonos.",
                "no": "På som standard. Lagring legger alarmen til i dette rommet, eller oppdaterer den hvis en alarm med samme tid, dager og lyd allerede finnes — så en volumendring endrer den alarmen i stedet for å legge til en ny. Slå av for å endre verdiene uten å røre Sonos."
              },
              "value": true
            },
            {
              "id": "newVolume",
              "type": "number",
              "label": {
                "en": "Volume",
                "no": "Volum"
              },
              "value": 30,
              "min": 0,
              "max": 100,
              "units": {
                "en": "%",
                "no": "%"
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Delete an alarm",
            "no": "Slett en alarm"
          },
          "children": [
            {
              "id": "alarmList",
              "type": "label",
              "label": {
                "en": "Alarms in this room",
                "no": "Alarmer i dette rommet"
              },
              "hint": {
                "en": "Updated automatically. The number in front matches the position to pick below.",
                "no": "Oppdateres automatisk. Tallet foran svarer til plassen du velger nedenfor."
              },
              "value": ""
            },
            {
              "id": "deletePosition",
              "type": "dropdown",
              "label": {
                "en": "Delete this one when saving",
                "no": "Slett denne når du lagrer"
              },
              "hint": {
                "en": "Pick a position from the list above and press Save. Apply when saving is switched off at the same time, so the alarm is not recreated in the same save. Deleting cannot be undone, and the alarm disappears from the Sonos app too. The choice resets itself afterwards.",
                "no": "Velg en plass fra lista over og trykk Lagre. «Bruk når du lagrer» slås av samtidig, så alarmen ikke gjenskapes i samme lagring. Sletting kan ikke angres, og alarmen forsvinner også fra Sonos-appen. Valget nullstiller seg selv etterpå."
              },
              "value": "none",
              "values": [
                {
                  "id": "none",
                  "label": {
                    "en": "Nothing",
                    "no": "Ingenting"
                  }
                },
                {
                  "id": "all",
                  "label": {
                    "en": "All alarms in this room",
                    "no": "Alle alarmer i dette rommet"
                  }
                },
                {
