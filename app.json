                    "en": "7",
                    "no": "7"
                  }
                },
                {
                  "id": "8",
                  "label": {
                    "en": "8",
                    "no": "8"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Days",
            "no": "Dager"
          },
          "children": [
            {
              "id": "daysPreset",
              "type": "dropdown",
              "label": {
                "en": "Quick pick",
                "no": "Hurtigvalg"
              },
              "hint": {
                "en": "Sets the seven days below when you save, then goes back to Custom so it never overrides days you picked yourself.",
                "no": "Setter de sju dagene nedenfor når du lagrer, og går så tilbake til Egendefinert — så den aldri overstyrer dager du har satt selv."
              },
              "value": "custom",
              "values": [
                {
                  "id": "custom",
                  "label": {
                    "en": "Custom",
                    "no": "Egendefinert"
                  }
                },
                {
