                }
              }
            ]
          }
        ]
      },
      {
        "id": "sonos_alarm_create",
        "title": {
          "en": "Create an alarm",
          "no": "Opprett en alarm"
        },
        "titleFormatted": {
          "en": "Create an alarm in [[room]] at [[time]] playing [[source]], repeating [[recurrence]], at volume [[volume]]",
          "no": "Opprett en alarm i [[room]] kl. [[time]] som spiller [[source]], gjentas [[recurrence]], med volum [[volume]]"
        },
        "hint": {
          "en": "The sound can be the built-in Sonos chime or any of your Sonos favourites, including radio stations.",
          "no": "Lyden kan være den innebygde Sonos-tonen eller hvilken som helst av Sonos-favorittene dine, radiostasjoner inkludert."
        },
        "args": [
          {
            "name": "room",
            "type": "autocomplete",
            "title": {
              "en": "Room",
              "no": "Rom"
            }
          },
          {
            "name": "time",
            "type": "time",
            "title": {
              "en": "Time",
              "no": "Tidspunkt"
            }
          },
          {
            "name": "recurrence",
            "type": "dropdown",
            "title": {
              "en": "Repeats",
              "no": "Gjentas"
            },
            "values": [
              {
                "id": "ONCE",
                "title": {
                  "en": "once",
                  "no": "én gang"
                }
              },
              {
                "id": "DAILY",
                "title": {
                  "en": "daily",
                  "no": "daglig"
                }
              },
              {
                "id": "WEEKDAYS",
                "title": {
                  "en": "on weekdays",
                  "no": "på ukedager"
                }
              },
              {
                "id": "WEEKENDS",
                "title": {
                  "en": "on weekends",
                  "no": "i helgen"
                }
              }
            ]
          },
