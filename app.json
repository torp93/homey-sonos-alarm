                    "en": "3",
                    "no": "3"
                  }
                },
                {
                  "id": "4",
                  "label": {
                    "en": "4",
                    "no": "4"
                  }
                },
                {
                  "id": "5",
                  "label": {
                    "en": "5",
                    "no": "5"
                  }
                },
                {
                  "id": "6",
