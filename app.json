            {
              "id": "createNow",
              "type": "checkbox",
              "label": {
                "en": "Create the alarm when saving",
                "no": "Opprett alarmen når du lagrer"
              },
              "hint": {
                "en": "Tick this and press Save. The alarm is added to this room with the values above, and the box clears itself so saving again does not create a duplicate.",
                "no": "Kryss av og trykk Lagre. Alarmen legges til i dette rommet med verdiene over, og krysset fjerner seg selv så en ny lagring ikke lager en duplikat."
              },
              "value": false
            },
            {
              "id": "newVolume",
              "type": "number",
              "label": {
                "en": "Volume",
                "no": "Volum"
              },
              "value": 30,
              "min": 0,
              "max": 100,
              "units": {
                "en": "%",
                "no": "%"
              }
            }
          ]
        },
